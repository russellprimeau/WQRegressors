{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "cwd": "${fileDirname}",
            // The manuscript is a sibling repository, so scripts that write into it
            // (z6_TargetSummaryTable.py) refuse to run without this. Resolves only
            // inside wq-forecasting.code-workspace.
            "env": {
                "WQ_MANUSCRIPT_ROOT": "${workspaceFolder:forecasting-hazardous-wq-manuscript}"
            }
        }
    ]
}
