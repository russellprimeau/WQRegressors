@article{DeLacerda2025,
title        = {Predicting the presence of total coliforms and Escherichia coli in water supply reservoirs using machine learning models},
author       = {M.C. {de Lacerda} and G.S. Batista and A.F.N. {de Souza} and D.P. Aragão and M.M. Cabral {de Araújo} and P.H. Cunha},
year         = {2025},
journal      = {Journal of Water Process Engineering},
volume       = {76},
pages        = {108146},
doi          = {https://doi.org/10.1016/j.jwpe.2025.108146},
issn         = {2214-7144},
url          = {https://www.sciencedirect.com/science/article/pii/S2214714425012188},
keywords     = {Artificial neural network, Random forest, Water quality monitoring, Public health, Microbiological contamination},
abstract     = {Monitoring microbiological contamination in drinking water is essential for ensuring water security and protecting public health. However, challenges persist, including insufficient laboratory infrastructure, limited financial resources, and delays in delivering microbiological analysis results. Machine learning (ML) offers promising alternatives for optimizing resources and enabling faster decision-making in public management. This study aimed to develop and validate models for predicting the presence of total coliforms and Escherichia coli in drinking water using Artificial Neural Networks (ANN) and Random Forest (RF) algorithms. Unlike previous studies, the models proposed here are directly applicable to drinking water and do not depend on expensive or incubation-dependent input parameters. RF outperformed ANN in over 90% of trained models. Average accuracies reached 77.8% for total coliforms and 80.3% for E. coli, with contaminated sample identification rates of 78.7% and 81.4%, respectively. The models performed similarly to laboratory methods and met international standards in over 66% of the analyzed hydrographic basins. Their use can significantly reduce the time required for microbiological assessments, accelerating responses and minimizing exposure to contaminants. Moreover, these models present a cost-effective and resource-efficient strategy for water quality monitoring, as they eliminate the need for reagents and laboratory analysis in many cases.}
}

