@inbook{Sene2024Hydrological,
title        = {Hydrological Forecasting},
author       = {Sene, Kevin},
year         = {2024},
booktitle    = {Hydrometeorology: Forecasting and Applications},
publisher    = {Springer Nature Switzerland},
address      = {Cham},
pages        = {167--215},
doi          = {10.1007/978-3-031-58269-1_5},
isbn         = {978-3-031-58269-1},
url          = {https://doi.org/10.1007/978-3-031-58269-1_5},
abstract     = {Hydrological models underpin many hydrometeorological forecasting techniques and include rainfall-runoff, flow routing and statistical approaches. Conceptual rainfall-runoff models are the most widely used in real-time forecasting, but physically based and data-driven models have an important role too, along with flow routing techniques encompassing both hydrological and hydrodynamic approaches. Ensemble and probabilistic techniques are increasingly used to estimate the uncertainty in outputs. Additional modelling components may be required to represent specific features of a catchment such as reservoirs, lakes and wetlands. For real-time use, models are typically operated within an automated forecasting system which controls the gathering of data, scheduling of model runs and data assimilation. This chapter provides an introduction to these various techniques along with operational considerations for real-time use, including data validation, pre- and post processing of outputs, and the important topics of forecast uncertainty and forecast verification.}
}

@inbook{Sene2024WQ,
title        = {Water Quality Forecasting},
author       = {Sene, Kevin},
year         = {2024},
booktitle    = {Hydrometeorology: Forecasting and Applications},
publisher    = {Springer Nature Switzerland},
address      = {Cham},
pages        = {421--443},
doi          = {10.1007/978-3-031-58269-1_12},
isbn         = {978-3-031-58269-1},
url          = {https://doi.org/10.1007/978-3-031-58269-1_12},
abstract     = {Water quality forecasting models are increasingly used to help with managing rivers, lakes and reservoirs. Applications include early warnings following pollution incidents, forecasting the progression of harmful algal blooms, and issuing bathing water quality advisories. Typically the functionality in flow forecasting models is extended to represent the transport of chemical or biological constituents as required. Model types include hydrodynamic models, flow routing models and distributed and integrated catchment models. However, empirical and statistical techniques are also used, including data-driven and artificial intelligence approaches. This chapter provides an introduction to these topics, including examples for the water quality alarm system on the river Rhine in the Netherlands and bathing water quality alerts in Scotland.}
}

